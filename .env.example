# App and local persistence
APP_NAME=RetrivAI
APP_ENV=development
APP_DEBUG=false
DATABASE_URL=postgresql://retrivai:retrivai@127.0.0.1:5432/retrivai
# Docker Compose database password for local development.
POSTGRES_PASSWORD=retrivai

# RAG models (weights download the first time a document is processed or queried)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
MAX_TOP_K=20
MIN_RELEVANCE_SCORE=0.22
MAX_CONTEXT_CHARS=14000

# OpenAI-compatible chat completions endpoint. Leave the key empty to use the
# built-in extractive answer mode until a provider key is configured.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# Browser/API settings
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=20
AUTH_COOKIE_NAME=retrivai_session
AUTH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_PER_MINUTE=90
